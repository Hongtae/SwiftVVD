{
  "version": 1,
  "presets": {
    "apple": {
      "bindings": {
        "textEditing.find": { "key": "f", "modifiers": ["command"] },
        "textEditing.findAndReplace": { "key": "f", "modifiers": ["command", "option"] },
        "textEditing.findNext": { "key": "g", "modifiers": ["command"] },
        "textEditing.findPrevious": { "key": "g", "modifiers": ["command", "shift"] },
        "textEditing.useSelectionForFind": { "key": "e", "modifiers": ["command"] },
        "textEditing.jumpToSelection": { "key": "j", "modifiers": ["command"] },
        "textEditing.showSpellingAndGrammar": { "key": ":", "modifiers": ["command"] },
        "textEditing.checkDocumentNow": { "key": ";", "modifiers": ["command"] },
        "textFormatting.alignLeft": { "key": "{", "modifiers": ["command"] },
        "textFormatting.alignCenter": { "key": "|", "modifiers": ["command"] },
        "textFormatting.alignRight": { "key": "}", "modifiers": ["command"] },
        "textFormatting.copyRuler": { "key": "c", "modifiers": ["command", "control"] },
        "textFormatting.pasteRuler": { "key": "v", "modifiers": ["command", "control"] },
        "toolbar.toggleVisibility": { "key": "t", "modifiers": ["command", "option"] },
        "sidebar.toggle": { "key": "s", "modifiers": ["command", "control"] },
        "inspector.toggle": { "key": "i", "modifiers": ["command", "control"] }
      }
    },
